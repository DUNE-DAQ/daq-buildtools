#!/usr/bin/env python3

import glob
import os
import re
import subprocess
import sys
import yaml

if "DBT_ROOT" in os.environ:
   DBT_ROOT=os.environ["DBT_ROOT"]
else:
    print("Environment variable DBT_ROOT isn't set, which suggests you haven't yet set up the daq-buildtools environment. Exiting...")
    sys.exit(1)


sys.path.append(f'{DBT_ROOT}/scripts')
from dbt_setup_tools import error, run_command, get_target_package_name

this_script = os.path.basename(__file__)
release_dir = os.environ["SPACK_RELEASES_DIR"] + "/" + os.environ["SPACK_RELEASE"]

target_package = get_target_package_name(release_dir)

def env_check():
    if not "SPACK_ROOT" in os.environ:
        error("It doesn't appear Spack was set up; exiting...")

def get_target_dir(package):
   res = subprocess.Popen(f"realpath $(spack location -p {package})/../..", 
                          shell=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE)

   errlines = res.stderr.readlines()
   assert len(errlines) == 0, "".join( [l.rstrip().decode("utf-8") for l in errlines] )

   return res.stdout.readlines()[0].rstrip().decode("utf-8")   

def get_release_data(package):        
   
   target_dir = get_target_dir(package)
    
   yamlfiles = [filename for filename in glob.glob(f"{target_dir}/*.yaml") if os.path.basename(filename) != "repo.yaml"]
    
   assert len(yamlfiles) == 1, f"Unable to find expected yaml file in {target_dir}"
   return yaml.safe_load(open(yamlfiles[0]))

def release_help():
    print(f"\n{this_script} release  # No additional arguments")

def release_info():

   releasedata = get_release_data("coredaq")

   base_release = releasedata["release"]
   target_dir = "Error"

   releasedata = get_release_data(target_package)
   target_dir = get_target_dir(target_package)

   full_release = releasedata["release"]
   full_release_type = releasedata["type"]
    
   pos = target_dir.find(full_release)
   release_dir = target_dir[:pos + len(full_release)]

   print(f"Release type: {full_release_type}")
   print(f"Release name: {full_release}")
   print(f"Base release name: {base_release}")
   print(f"Release dir: {release_dir}")
 
def release_size_help():
   print(f"\n{this_script} release_size  # No additional arguments")

def release_size_info():

   process = subprocess.Popen('spack repo list', shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

   stdout, stderr = process.communicate()
  
   if process and process.returncode == 0:
      repopaths = []
      for line in stdout.decode("utf-8").split("\n"):
         res = re.search(r"(/cvmfs.*spack-[0-9\.]+).*", line)
         if res:
            repopath = res.group(1)

            if repopath not in repopaths:
               repopaths.append(repopath)

      print()      
      for repopath in repopaths:
         label=repopath.split("/")[-2]
         print(f"{label}:")
         print(f"path: {repopath}")
         run_command(f"du {repopath} -sk | sed -r -n 's/^([0-9]+).*/size: \\1 kB/p'")
         print("number of packages: ", end = "") 
         run_command(f"spack find -p --loaded | grep {repopath} | wc -l")
         print()
   else:
      error("Something went wrong trying to find the Spack repos used in this release")

def package_help():
   print(f"\n{this_script} package <name of package>  # Use \"all\" instead of a package name for all DUNE DAQ packages")

def package_print(pkg, check_spack = True):
   print()  
   for vartype in pkg.keys():
      print(f"{vartype}: {pkg[vartype]}")
   print()

   source_path = "%s/sourcecode/%s" % (os.environ["DBT_AREA_ROOT"], pkg["name"])
   if os.path.exists(source_path):
      print(f"""Information about package for this release may not be accurate since it's being 
developed in your work area ({source_path})""")
   elif check_spack:
      run_command("spack find -p -l --loaded %s" % (pkg["name"]))
   print()

def package_info(requested_pkg, ok_to_miss = False):

   was_found = False

   base_data = get_release_data("coredaq")

   release_data = get_release_data(target_package)

   base_packages = base_data["coredaq"]

   for pkg in base_packages:
      if pkg["name"] == requested_pkg or requested_pkg == "all":
         was_found = True
         package_print(pkg)
         if requested_pkg != "all":
             return

   for pkg in release_data[ target_package ]:
      if pkg["name"] == requested_pkg or requested_pkg == "all":
         was_found = True
         package_print(pkg)
         if requested_pkg != "all":
            return
   
   if not was_found and not ok_to_miss:
      print(f"Unable to find \"{requested_pkg}\"")

def local_package_info(package_path):
   package_name = package_path.split("/")[-1]
   package_base_path = package_path.split("/")[-2]
   package_type = "C++"
   if "pythoncode" in package_path:
      package_type = "python"

   current_branch = run_command(
      "git rev-parse --abbrev-ref HEAD",
      echo=False, cwd=package_path,
      context="Could not determine branch name"
   ).stdout.strip()

   short_sha = run_command(
      "git rev-parse --short HEAD",
      echo=False, cwd=package_path,
      context="Could not determine the current commit"
   ).stdout.strip()

   diff = run_command(
      "git diff --no-ext-diff --quiet HEAD",
      echo=False, cwd=package_path, check=False, warn=False,
   )
   if diff.returncode not in (0, 1):
      raise RuntimeError(
         f"git diff failed ({diff.returncode}): {diff.stderr.strip()}"
      )

   has_uncommitted_changes = diff.returncode == 1

   print(
      f"DUNE DAQ {package_type} package {package_name} "
      f"in {package_base_path}/: "
      f"{current_branch}{'*' if has_uncommitted_changes else ''} "
      f"[{short_sha}]"
   )
 
def externals_help():
    print(f"\n{this_script} external <name of package>  # Use \"all\" instead of a package name for all external packages") 

def externals_info(requested_pkg, ok_to_miss = False): 

   was_found = False
   externals_data = get_release_data("externals")  
   
   for pkg in externals_data["externals"]:
      if pkg["name"] == requested_pkg or requested_pkg == "all":
         was_found = True
         package_print(pkg)
         if requested_pkg != "all":
            return

   if not was_found and not ok_to_miss:
      print(f"Unable to find \"{requested_pkg}\"")

def pymodule_help():
   print(f"\n{this_script} pymodule <name of Python module> # Use \"all\" instead of a package name to list all DUNE DAQ Python packages")

def pymodule_info(requested_package):

   packages = []
   if requested_package != "all":
      packages.append( requested_package )
   else:
      pattern = re.compile(r'git\+https://github\.com/DUNE-DAQ/([^@]+)@')
      with open("%s/%s/pyvenv_requirements.txt" % (os.environ["SPACK_RELEASES_DIR"], os.environ["SPACK_RELEASE"]), 'r') as inf:
         for line in inf:
            match = pattern.search(line)
            if match:
                packages.append( match.group(1) )

   for package in packages:
      process_pymodule(package)

def process_pymodule(package):

   venv_subdir = package
   if package == "daq-assettools":
      venv_subdir = "daq_assettools"
   elif package == "runconf-ui":
      venv_subdir = "runconf_ui"

   possible_venv_dir = glob.glob( "%s/.venv/lib/python*/site-packages/%s" % (os.environ["DBT_AREA_ROOT"], venv_subdir ))
   possible_pythoncode_dir = glob.glob( "%s/pythoncode/%s" % (os.environ["DBT_AREA_ROOT"], package ))

   if len(possible_venv_dir) + len(possible_pythoncode_dir) == 0:

      # Need to find the package in Spack
      if package[0:3] != "py-":
         error("The requested package wasn't found in .venv or pythoncode/ and doesn't appear to be a Python package in Spack")

      package_info(package, ok_to_miss = True)
      externals_info(package, ok_to_miss = False)

   elif len(possible_pythoncode_dir) == 1:

      # Local $DBT_AREA_ROOT/pythoncode takes priority over .venv

      package_path = "%s/pythoncode/%s" % (os.environ["DBT_AREA_ROOT"], package)
      if not os.path.isdir(package_path):
         error("Some logic in this script is broken; contact Software Coordination")
      local_package_info(package_path)

   elif len(possible_venv_dir) == 1:

      # Local work area .venv installation takes priority over Spack
      # installation, get version from YAML file from which the python
      # packages are locally installed

      pyvenv_file = "%s/%s/pyvenv_requirements.txt" % (os.environ["SPACK_RELEASES_DIR"], os.environ["SPACK_RELEASE"])
      assert os.path.exists(pyvenv_file)

      pattern1 = re.compile(
        rf'git\+https://github\.com/DUNE-DAQ/{re.escape(package)}@([0-9a-zA-Z/\.]+)#egg'
    )

      pattern2 = re.compile(
         rf'{re.escape(package)}==([0-9\.]+)'
         )

      with open(pyvenv_file, 'r') as f:
        content = f.read()

      match = pattern1.search(content)

      if match:
         print(f"DUNE DAQ Python package \"{package}\" taken from commit or branch \"{match.group(1)}\"")
         return

      match = pattern2.search(content)
      if match:
         print(f"External Python package \"{package}\" at version \"{match.group(1)}\"")
         return

      print(f"Unable to find info on Python package {package}; may not be listed in {pyvenv_file}")

   else:
      error("Flaw in the logic of this script; please contact John Freeman at jcfree@fnal.gov")

def sourcecode_help():
   print(f"\n{this_script} sourcecode  # No additional arguments")

def sourcecode_info():
   codepaths = []

   for subdir in ["sourcecode", "pythoncode"]:
      codepaths.append( "%s/%s" % (os.environ["DBT_AREA_ROOT"], subdir) )

   repos = []
   for codepath in codepaths:
      if not os.path.exists( codepath ):
         error(f"Are you sure you have a work area set up? Unable to find expected path {codepath}; exiting...")

      for repo in [os.path.join(codepath, d) for d in os.listdir(codepath) if os.path.isdir(os.path.join(codepath, d))]:
         repos.append(repo)

   print()
   if repos:
      print('Source code for locally checked out package(s):')
      for repo in repos:
         local_package_info(repo)
   else: 
      print('There are no locally checked out packages in $DBT_AREA_ROOT/sourcecode')
   print()

   print(f"Source code for packages not checked out locally is in\n{os.environ.get('DUNE_DAQ_RELEASE_SOURCE')}")

def full_help():
    release_help()
    package_help()
    externals_help()
    pymodule_help()
    sourcecode_help()
    release_size_help()

env_check()

if len(sys.argv) == 1:
    full_help()
    sys.exit(1)

infotype = sys.argv[1]

if infotype == "package":
    if len(sys.argv) < 3:
       package_help()
       sys.exit(1)
    package_info(sys.argv[2])
elif infotype == "external":
    if len(sys.argv) < 3:
       externals_help()
       sys.exit(1)
    externals_info(sys.argv[2])
elif infotype == "pymodule":
    if len(sys.argv) < 3:
       pymodule_help()
       sys.exit(1)
    pymodule_info(sys.argv[2])
elif infotype == "release":
    release_info()
elif infotype == "sourcecode":
   sourcecode_info()
elif infotype == "release_size":
   release_size_info()
else:  # This encompasses when a user passes "-h" or "--help", but also "--smurf" or "--albania"
    full_help()



